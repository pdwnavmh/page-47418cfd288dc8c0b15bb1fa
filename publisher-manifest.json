e:12.5px;color:var(--mute);border-top:1px solid var(--line);line-height:1.7}\n\n/* ---------- clients (empty-safe) ---------- */\n.clients{background:var(--ink-2);border-top:1px solid var(--line)}\n.client-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:34px;align-items:start}\n.client-copy p{color:#b7c0b3;font-size:15.5px;max-width:50ch}\n.client-copy p + p{margin-top:14px}\n.client-card{border:1px solid var(--line);border-radius:22px;padding:26px;background:var(--ink-3);box-shadow:0 24px 50px -34px rgba(0,0,0,.9)}\n.client-card h3{font-size:16px;letter-spacing:.02em}\n.client-card ul{margin:14px 0 0;padding-left:20px;color:#b7c0b3;font-size:14.5px}\n.client-card li + li{margin-top:8px}\n.client-card .foot{margin-top:18px;padding-top:14px;border-top:1px dashed #2a2f2a;font-size:12.5px;color:var(--mute)}\n\n/* ---------- faq ---------- */\n.faq{background:var(--ink);border-top:1px solid var(--line)}\n.faq-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 40px}\n.qa{padding:26px 0;border-top:1px solid var(--line)}\n.qa h3{font-size:16.5px;margin-bottom:10px;display:flex;gap:12px}\n.qa h3 .q{color:var(--lime);font-weight:800;font-size:13px;letter-spacing:.08em;padding-top:3px;flex:none}\n.qa p{font-size:14.5px;color:#b7c0b3;padding-left:25px}\n\n/* ---------- footer ---------- */\nfooter{border-top:1px solid var(--line);padding:38px 0 46px;background:#090a09}\n.foot-grid{display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap;align-items:flex-start}\n.foot-brand{font-weight:800;font-size:17px;letter-spacing:.04em}\n.foot-brand small{display:block;font-weight:600;font-size:12.5px;color:var(--mute);letter-spacing:.02em;margin-top:8px;max-width:52ch;line-height:1.7}\n.foot-links{display:flex;gap:8px;flex-wrap:wrap}\n.foot-links a{font-size:12.5px;text-decoration:none;color:#cfd6cc;border:1px solid var(--line);border-radius:999px;padding:7px 13px}\n.foot-links a:hover,.foot-links a:focus-visible{border-color:var(--lime);color:var(--lime);outline:none}\n\n@media (max-width:900px){\n  .hero-grid{grid-template-columns:1fr;gap:36px;padding-top:40px}\n  .steps{grid-template-columns:1fr}\n  .client-grid{grid-template-columns:1fr}\n  .faq-grid{grid-template-columns:1fr}\n  section{padding:60px 0}\n  .qa p{padding-left:0}\n}\n@media (max-width:520px){\n  .wrap{width:calc(100% - 32px)}\n  .panel{padding:20px;border-radius:20px}\n  th,td{padding:15px 16px}\n  .topbar{padding-bottom:14px}\n}\n</style><main>\n\n  <header class=\"hero\">\n    <div class=\"wrap\">\n      <div class=\"topbar\">\n        <div class=\"brandmark\"><span class=\"dot\"></span>千速云</div>\n        <nav class=\"tags\" aria-label=\"页内目录\">\n          <a class=\"tag\" href=\"#usage\">使用说明</a>\n          <a class=\"tag\" href=\"#plans\">套餐对比</a>\n          <a class=\"tag\" href=\"#clients\">客户端</a>\n          <a class=\"tag\" href=\"#faq\">常见问题</a>\n        </nav>\n      </div>\n\n      <div class=\"hero-grid\">\n        <div>\n          <p class=\"eyebrow\">Subscription · 三档可选</p>\n          <h1>千速云\n            <span class=\"thin\">套餐先看表，再决定。流量、设备数、线路，一项一项列清楚。</span>\n          </h1>\n          <p class=\"hero-lede\">\n            我们把三档套餐摊在同一张表里：<strong>基础版走日�的常规线路</strong>，旗舰版加了专线与流媒体层面，\n            团队版面向多人共用。<strong>没有隐藏档位，也没有默认勾选</strong>——选哪一档，取决于你每月实际用多少、几台设备同时在线。\n          </p>\n          <p class=\"hero-lede\">\n            年付价格单独标出，差价算得出来。不确定的部分，写在常见问题里，逐条回答。\n          </p>\n          <div class=\"hero-links\">\n            <a class=\"btn btn-primary\" href=\"#plans\">查看套餐对比</a>\n            <a class=\"btn btn-ghost\" href=\"#usage\">先读使用说明</a>\n          </div>\n        </div>\n\n        <aside class=\"panel\" aria-label=\"套餐速览\">\n          <h2>速览</h2>\n          <div class=\"panel-rows\">\n            <div class=\"row\">\n              <span class=\"k\">可选档位</span>\n              <span class=\"v\">3 档<small>基础 / 旗舰 / 团队</small></span>\n            </div>\n            <div class=\"row\">\n              <span class=\"k\">月付起价</span>\n              <span class=\"v\">¥15<small>基础版 · 每月</small></span>\n            </div>\n            <div class=\"row\">\n              <span class=\"k\">流量区间</span>\n              <span class=\"v\">100GB — 1000GB<small>按档位递增</small></span>\n            </div>\n            <div class=\"row\">\n              <span class=\"k\">设备上限</span>\n              <span class=\"v\">3 / 5 / 20 台<small>同时在线</small></span>\n            </div>\n            <div class=\"row\">\n              <span class=\"k\">计费周期</span>\n              <span class=\"v\">月付或年付<small>年付按十个月折算</small></span>\n            </div>\n          </div>\n          <p class=\"panel-note\">\n            以上为套餐页面展示的公开信息。实际可用线路与解锁范围以你开通时所选档位为准，跨档不共享额度。\n          </p>\n        </aside>\n      </div>\n    </div>\n  </header>\n\n  <section class=\"usage\" id=\"usage\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div>\n          <p class=\"eyebrow\">Before you pick</p>\n          <h2>三步选对档位</h2>\n        </div>\n        <p class=\"sub\">先算用量，再看设备数，最后看线路。顺序反了，容易买多，也容易买少。</p>\n      </div>\n\n      <div class=\"steps\">\n        <article class=\"step\">\n          <p class=\"idx\">STEP 01</p>\n          <h3>估算每月流量</h3>\n          <p>把上个月的实际用量翻出来看。浏览器下载、系统更新、在线视频都算在内。</p>\n          <p>个人日常使用多在 100GB 以内；有长期看高清视频或频繁传文件的，往 300GB 档看。</p>\n        </article>\n        <article class=\"step\">\n          <p class=\"idx\">STEP 02</p>\n          <h3>数清同时在线设备</h3>\n          <p>手机、平板、笔记本分开计。上限指同时在线，不是累计授权。</p>\n          <p>一个人两三台属正常；家庭或小组共用，直接看团队版的 20 台。</p>\n        </article>\n        <article class=\"step\">\n          <p class=\"idx\">STEP 03</p>\n          <h3>对照线路与支持</h3>\n          <p>基础版为普通线路节点池；旗舰版含专线优化与流媒体解锁；团队版为高带宽节点。</p>\n          <p>对响应时间敏感，或需要工单优先处理，档位差异在这里体现。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"plans\" id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div>\n          <p class=\"eyebrow\">Plans</p>\n          <h2>套餐横向对比</h2>\n        </div>\n        <p class=\"sub\">同一行对比同一项。差别在哪一目了然，不必来回翻页。</p>\n      </div>\n\n      <div class=\"table-shell\">\n        <div class=\"scroll\">\n          <table>\n            价格与权益对照。年付价为一次性支付金额，按 12 个月使用。\n            <thead>\n              <tr>\n                <th>对比项</th>\n                <th class=\"plan-col\">\n                  基础版\n                  <span class=\"price\">¥15<span> /月</span></span>\n                  <span class=\"year\">年付 ¥150 / 年</span>\n                </th>\n                <th class=\"plan-col featured\">\n                  旗舰版\n                  <span class=\"price\">¥35<span> /月</span></span>\n                  <span class=\"year\">年付 ¥350 / 年</span>\n                  <span class=\"pick\">推荐</span>\n                </th>\n                <th class=\"plan-col\">\n                  团队版\n                  <span class=\"price\">¥85<span> /月</span></span>\n                  <span class=\"year\">年付 ¥850 / 年</span>\n                </th>\n              </tr>\n            </thead>\n            <tbody>\n              <tr>\n                <th class=\"rowlabel\">每月流量</th>\n                <td>100GB</td>\n                <td class=\"featured\">300GB</td>\n                <td>1000GB</td>\n              </tr>\n              <tr>\n                <th class=\"rowlabel\">同时在线设备</th>\n                <td>3 台</td>\n                <td class=\"featured\">5 台</td>\n                <td>20 台</td>\n              </tr>\n              <tr>\n                <th class=\"rowlabel\">流媒体解锁</th>\n                <td>基础流媒体</td>\n                <td class=\"featured\">全节点原生解锁</td>\n                <td>全节点原生解锁</td>\n              </tr>\n              <tr>\n                <th class=\"rowlabel\">线路</th>\n                <td>普通线路节点池</td>\n                <td class=\"featured\">IPLC 专线，游戏加速优化</td>\n                <td>VIP 专属高带宽节点</td>\n              </tr>\n              <tr>\n                <th class=\"rowlabel\">路由定制</th>\n                <td>不支持</td>\n                <td class=\"featured\">不支持</td>\n                <td>支持企业定制路由</td>\n              </tr>\n              <tr>\n                <th class=\"rowlabel\">工单支持</th>\n                <td>标准工单</td>\n                <td class=\"featured\">7×24 优先工单</td>\n                <td>专属客户经理</td>\n              </tr>\n              <tr>\n                <th class=\"rowlabel\">适合谁</th>\n                <td>单人日常，用量可控</td>\n                <td class=\"featured\">多设备个人，看重线路质量</td>\n                <td>小组或团队共用</td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n        <p class=\"table-foot\">\n          年付金额为对应档位的一次性费用，与月付按十个月折算的结果一致。套餐内容以开通页面展示为准，档位之间不支持临时加量或跨档共用流量。\n        </p>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"clients\" id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div>\n          <p class=\"eyebrow\">Clients</p>\n          <h2>客户端怎么选</h2>\n        </div>\n        <p class=\"sub\">按你的系统选。安装包与具体版本，以官方发布页为准。</p>\n      </div>\n\n      <div class=\"client-grid\">\n        <div class=\"client-copy\">\n          <p>千速云不限定单一客户端。你手边是什么系统，就先用对应系统上成熟的客户端，配置信息开通后由你自己填写。</p>\n          <p>桌面端优先用带分流的客户端，能把局域网与国内流量排除在外，减少不必要的消耗。移动端注意系统省电策略，长时间后台会被挂起。</p>\n          <p>同一账号在多台设备登录时，占用的正是套餐里标明的同时在线数。换设备前先退出旧设备，避免超出上限。</p>\n        </div>\n        <div class=\"client-card\">\n          <h3>环境准备要点</h3>\n          <ul>\n            <li>桌面系统：使用支持规则分流的客户端，配置项按开通信息逐条填入。</li>\n            <li>移动系统：关闭针对客户端的后台限制，保持省电白名单畅通。</li>\n            <li>路由器或团队场景：统一在一台设备上配置，再分发给组内成员。</li>\n            <li>首次使用：先测一次延迟与下载，确认线路可达后再投入日常使用。</li>\n          </ul>\n          <p class=\"foot\">页面不提供安装包下载。具体客户端名称、版本与获取途径，请以官方渠道发布的信息为准。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"faq\" id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div>\n          <p class=\"eyebrow\">FAQ</p>\n          <h2>常见问题</h2>\n        </div>\n        <p class=\"sub\">问题按出现频率排列，答案尽量写具体。</p>\n      </div>\n\n      <div class=\"faq-grid\">\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q1</span>三档套餐最先看哪一项？</h3>\n          <p>先看每月流量。用量决定档位下限，设备数决定上限，线路则影响体验。若流量与设备数都卡在临界，选高一档更省心。</p>\n        </article>\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q2</span>同时在线设备数是怎么算的？</h3>\n          <p>指同一时间保持连接的数量。基础版 3 台、旗舰版 5 台、团队版 20 台。关掉旧设备的连接，就腾出了位置。</p>\n        </article>\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q3</span>年付和月付差多少？</h3>\n          <p>按页面标价，年付是月付金额的十倍：基础版 ¥150、旗舰版 ¥350、团队版 ¥850。相当于两个月不收费。</p>\n        </article>\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q4</span>当月流量用完了会怎样？</h3>\n          <p>流量按自然月计，超出后需等下一个周期重置，或改选更高流量档位。档位之间不共享额度，也不临时加量。</p>\n        </article>\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q5</span>旗舰版的专线对游戏有帮助吗？</h3>\n          <p>旗舰版标明的线路含 IPLC 专线与游戏加速优化。实际效果受本地网络与目标服务器影响，建议开通后先用一两局实测。</p>\n        </article>\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q6</span>团队版可以给组内成员各用一台吗？</h3>\n          <p>可以，只要同时在线的总数不超过 20 台。团队版另含企业定制路由与专属客户经理，多人协作场景更适配。</p>\n        </article>\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q7</span>客户端需要另外付费吗？</h3>\n          <p>不需要。客户端的选择由你自行决定，套餐费用只对应订阅本身。安装包请通过官方渠道获取，页面不提供下载。</p>\n        </article>\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q8</span>怎么判断该不该升档？</h3>\n          <p>连续两个月流量接近上限，或经常需要踢掉某台设备才能连接，就说明档位偏低了。反之则不必提前升级。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap foot-grid\">\n    <div class=\"foot-brand\">\n      千速云\n      <small>三档套餐，一张对照表。价格与权益以开通页面展示为准；页面不提供安装包下载，也不构成任何性能承诺。</small>\n    </div>\n    <nav class=\"foot-links\" aria-label=\"页脚目录\">\n      <a href=\"#usage\">使用说明</a>\n      <a href=\"#plans\">套餐对比</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n  </div>\n</footer>",
